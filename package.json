{
  "name": "arpli",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first application intelligence hub",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:daemon dev:desktop",
    "dev:desktop": "npm run dev --workspace apps/desktop",
    "dev:daemon": "npm run dev --workspace packages/daemon",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "lint": "eslint . --ext .ts,.svelte",
    "format": "prettier --write .",
    "db:migrate": "npm run migrate --workspace packages/db"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-plugin-svelte": "^2.46.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.3.3",
    "prettier-plugin-svelte": "^3.2.6",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "vite": "^6.0.0"
  }
}

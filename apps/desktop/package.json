{
  "name": "@arpli/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm-run-all --parallel dev:vite dev:electron",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && npm run build:electron && cross-env NODE_ENV=development electron .",
    "build": "vite build && npm run build:electron",
    "build:electron": "tsc -p electron/tsconfig.json && node -e \"require('fs').cpSync('electron/preload.cjs', 'dist-electron/preload.cjs')\"",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@arpli/shared": "*",
    "@tailwindcss/typography": "^0.5.20",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.22.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "electron": "^32.1.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.47",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^3.4.11",
    "tslib": "^2.7.0",
    "typescript": "^5.5.4",
    "vite": "^6.0.0",
    "wait-on": "^8.0.0"
  }
}

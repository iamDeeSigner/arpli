{
  "name": "@arpli/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm-run-all --parallel dev:vite dev:electron",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && npm run build:electron && cross-env NODE_ENV=development electron .",
    "build": "vite build && npm run build:electron",
    "build:electron": "tsc -p electron/tsconfig.json && node -e \"require('fs').cpSync('electron/preload.cjs', 'dist-electron/preload.cjs')\"",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@arpli/shared": "*",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "bits-ui": "^2.18.1",
    "cross-env": "^7.0.3",
    "date-fns": "^4.4.0",
    "electron": "^32.1.0",
    "npm-run-all": "^4.1.5",
    "phosphor-svelte": "^3.1.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.0.0",
    "svelte-sonner": "^1.2.1",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.7.0",
    "typescript": "^6.0.3",
    "vite": "^6.0.0",
    "wait-on": "^8.0.0"
  }
}
